# 数据与脚本统一使用 LF：避免 index.json 在不同系统上产生无意义 diff，
# 也保证 .githooks 下的 shell 钩子在 Windows 上仍可执行。
* text=auto eol=lf

*.json   text eol=lf
*.md     text eol=lf
*.mjs    text eol=lf
*.js     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
.githooks/* text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf