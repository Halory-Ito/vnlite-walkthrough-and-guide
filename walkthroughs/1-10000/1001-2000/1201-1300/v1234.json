            },
            {
              "id": "step_azuma_ayami_17",
              "type": "choice",
              "content": "请让我把它当成是绚水来清洗一番",
              "group": "8月16日（一）"
            },
            {
              "id": "step_azuma_ayami_18",
              "type": "choice",
              "content": "请让我把它当成是雪江姐来清洗一番",
              "group": "8月16日（一）"
            },
            {
              "id": "step_azuma_ayami_19",
              "type": "choice",
              "content": "酒还是要成年以后才能喝",
