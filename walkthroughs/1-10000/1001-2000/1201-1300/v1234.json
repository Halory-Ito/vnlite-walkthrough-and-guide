            },
            {
              "id": "step_azuma_ayami_20",
              "type": "choice",
              "content": "喝一点应该是没关系吧",
              "group": "8月18日（三）"
            },
            {
              "id": "step_azuma_ayami_21",
              "type": "choice",
              "content": "刚刚应试合格的绚水",
              "group": "8月8日（一）"
            },
            {
              "id": "step_azuma_ayami_22",
              "type": "choice",
              "content": "举办个展的雪江姐",
              "group": "8月8日（一）"
            },
            {
              "id": "step_azuma_ayami_23",
              "type": "choice",
              "content": "这里对绚水你来说也是个重要场所呢",
              "group": "8月9日（二）"
            },
            {
              "id": "step_azuma_ayami_24",
              "type": "choice",
              "content": "话说回来，绚水你的爸爸呢？",
              "group": "8月9日（二）"
            },
            {
              "id": "step_azuma_ayami_25",
              "type": "choice",
              "content": "那个事故，是交通事故还是什么的吗？",
              "group": "8月10日（三）"
            },
            {
              "id": "step_azuma_ayami_26",
              "type": "choice",
              "content": "由于那次事故，所以你就住院了？",
              "group": "8月10日（三）"
            },
            {
              "id": "step_azuma_ayami_27",
              "type": "choice",
              "content": "那与绚水发生的事故，应该会有些关系吧",
              "group": "8月10日（三）"
            },
            {
              "id": "step_azuma_ayami_28",
              "type": "choice",
              "content": "关于绚水的事情，我总是耿耿于怀……",
              "group": "8月10日（三）"
            }
          ]
