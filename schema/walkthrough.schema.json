{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "视觉小说攻略",
  "description": "walkthroughs/ 下单个攻略文件的结构。仓库地址发布后可用 $id 指向 raw URL，便于外部引用。",
  "type": "object",
  "required": ["vid", "updatedAt", "routes"],
  "additionalProperties": false,
  "properties": {
    "vid": {
      "description": "VNDB 编号，形如 v184；同时必须与文件名、分区目录一致",
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "name": {
      "description": "游戏标题的多语言映射，键为 BCP 47 语言代码",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "level": {
      "description": "分级/难度等数值标识（沿用数据源原值）",
      "type": "integer",
      "minimum": 0
    },
    "author": { "description": "攻略作者", "type": "string", "minLength": 1 },
    "contact": { "description": "作者联系方式：邮箱、社交账号或主页", "type": "string", "minLength": 1 },
    "updatedAt": {
      "description": "最后一次更新日期",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tips": {
      "description": "全局提示",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "id": {
      "description": "唯一标识，建议 <kind>_<timestamp> 形式，如 step_1755094701246",
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "route": {
      "type": "object",
      "required": ["name", "endings"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "description": "路线名称，通常是角色名或章节名", "type": "string", "minLength": 1 },
        "endings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ending" }
        }
      }
    },
    "ending": {
      "type": "object",
      "required": ["name", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "description": "结局类型，默认 normal",
          "type": "string",
          "enum": ["normal", "bad", "good", "true"],
          "default": "normal"
        },
        "requirements": { "description": "开启条件说明", "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "description": "步骤类型，默认 choice",
          "type": "string",
          "enum": ["choice", "save", "load", "note"],
          "default": "choice"
        },
        "content": { "description": "步骤内容", "type": "string", "minLength": 1 },
        "prefix": { "description": "前缀标记，如 ※ ★ ◆", "type": "string", "minLength": 1 },
        "subfix": { "description": "后缀说明，如 CG回收", "type": "string", "minLength": 1 },
        "group": { "description": "日期或章节分组，如 7月25日", "type": "string", "minLength": 1 }
      }
    }
  }
}