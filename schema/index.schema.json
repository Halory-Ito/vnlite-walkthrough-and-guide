{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "攻略索引 index.json",
  "description": "根目录索引：由 scripts/build-index.mjs 扫描 walkthroughs/ 自动生成，请勿手工编辑。path 为仓库相对路径，拼上 raw 前缀即可访问原始攻略。",
  "type": "object",
  "required": ["schemaVersion", "count", "walkthroughs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "latestUpdatedAt": {
      "description": "所有攻略中最新的 updatedAt（由数据推导，不含构建时间，保证可复现）",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "walkthroughs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vid", "path", "updatedAt", "routesCount", "endingsCount", "stepsCount"],
        "additionalProperties": false,
        "properties": {
          "vid": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
          "path": {
            "description": "攻略文件相对仓库根目录的路径",
            "type": "string",
            "pattern": "^walkthroughs/[0-9]+-[0-9]+/[0-9]+-[0-9]+/[0-9]+-[0-9]+/v[0-9]+\\.json$"
          },
          "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "routesCount": { "type": "integer", "minimum": 0 },
          "endingsCount": { "type": "integer", "minimum": 0 },
          "stepsCount": { "type": "integer", "minimum": 0 },
          "name": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "level": { "type": "integer", "minimum": 0 },
          "author": { "type": "string", "minLength": 1 },
          "contact": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}